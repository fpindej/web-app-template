{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "extraKnownMarketplaces": {
    "dotnet-agent-skills": {
      "source": { "source": "github", "repo": "dotnet/skills" }
    },
    "aspire-skills": {
      "source": { "source": "github", "repo": "microsoft/aspire-skills" }
    },
    "Svelte": {
      "source": { "source": "github", "repo": "sveltejs/ai-tools" }
    }
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "dotnet-aspnetcore@dotnet-agent-skills": true,
    "dotnet-data@dotnet-agent-skills": true,
    "dotnet-test@dotnet-agent-skills": true,
    "aspire@aspire-skills": true,
    "svelte@Svelte": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(pnpm)",
      "Bash(dotnet *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(git cat-file*)",
      "Bash(git rev-parse*)",
      "Bash(git show *)",
      "Bash(git fetch*)",
      "Bash(git ls-files*)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git remote *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh api --method GET *)",
      "Bash(gh api --method POST */sub_issues*)",
      "Bash(gh api repos/*/replies --method POST*)",
      "Bash(gh repo view*)",
      "Bash(gh run *)",
      "Bash(gh release *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(docker build*)",
      "Bash(docker compose version*)",
      "Bash(docker compose config*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose down*)",
      "Bash(docker info*)",
      "Bash(docker ps*)",
      "Bash(docker images*)",
      "Bash(docker logs*)",
      "Bash(docker volume ls*)",
      "Bash(which *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Write(*.env.example)",
      "Write(*.env.test)",
      "Edit(*.env.example)",
      "Edit(*.env.test)"
    ],
    "deny": [
      "Bash(git push --force *main*)",
      "Bash(git push --force *master*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * HEAD:master*)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh repo delete*)",
      "Bash(gh repo fork*)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *-X delete*)",
      "Bash(gh api *secrets*)",
      "Bash(gh api *keys*)",
      "Bash(gh api *hooks*)",
      "Bash(docker run *--privileged*)",
      "Bash(docker run *-v /:*)",
      "Bash(docker run *-v ~*)",
      "Bash(docker run *-v $HOME*)",
      "Bash(docker *--privileged*)",
      "Bash(docker *compose* run *-v*)",
      "Bash(docker *compose* run *--volume*)",
      "Bash(docker *compose* run *--mount*)",
      "Bash(docker *buildx*--output*)",
      "Bash(docker *build*--output*)",
      "Bash(gh repo edit*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -rf src)",
      "Bash(git checkout main && git merge*)",
      "Bash(git checkout master && git merge*)",
      "Bash(git switch main && git merge*)",
      "Bash(git switch master && git merge*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(Remove-Item * -Recurse*)",
      "Bash(rd /s *)",
      "Bash(rmdir /s *)",
      "Bash(del /s *)",
      "Bash(Invoke-Expression *)",
      "Bash(iex *)",
      "Bash(iwr * | iex*)",
      "Bash(Invoke-WebRequest * | Invoke-Expression*)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Write(pnpm-lock.yaml)",
      "Edit(pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-bash.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-format.mjs\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-quality-gate.mjs\""
          }
        ]
      }
    ]
  }
}
